[Unit]
Description=OATS Biobattery Redpanda Connect pipeline %i

[Container]
ContainerName=rpc_%i
Image=docker.io/redpandadata/connect:latest
Network=oats.network

Volume=./transformers/%i.yaml:/connect.yaml:ro

Secret=rpc_tsdb_biobatt,type=env,target=POSTGRES_DSN
Environment=NATS_URL=nats://oats-nats:4222
Environment=NATS_STREAM=BIOBATTERY

Exec=run

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target default.target
DefaultInstance=peaks-ts
