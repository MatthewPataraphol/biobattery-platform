[Unit]
Description=OATS Biobattery Redpanda Connect pipeline %i

[Container]
ContainerName=rpc_%i
Image=docker.io/redpandadata/connect:latest

Exec=run /transformers/%i.yaml
WorkingDir=/transformers

Volume=./transformers:/transformers:ro

Environment=NATS_URL=nats://host.containers.internal:4222
Environment=NATS_STREAM=BIOBATTERY

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target default.target
DefaultInstance=peaks-jsonl
