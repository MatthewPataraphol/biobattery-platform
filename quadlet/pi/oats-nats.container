[Unit]
Description=OATS NATS Server with JetStream
After=network-online.target
Wants=network-online.target
Conflicts=nats-server.service

[Container]
ContainerName=oats-nats
Image=docker.io/library/nats:2.11
Network=oats.network

PublishPort=4222:4222
PublishPort=127.0.0.1:8222:8222

Volume=/etc/oats/nats/nats-server.conf:/etc/nats/nats-server.conf:ro
Volume=/var/lib/oats/nats/jetstream:/data/jetstream

Exec=-c /etc/nats/nats-server.conf

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
