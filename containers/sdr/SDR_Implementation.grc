- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nOATS B200mini Peak Detector + JSONL Logger + NATS Publisher\n\
      \nInput:\n    float32 vector of FFT power values from:\n    UHD Source -> Stream\
      \ to Vector -> FFT -> Complex to Mag^2\n\nOutput:\n    None\n\nThis block:\n\
      \    - averages the power spectrum\n    - searches for strongest peak from min_freq\
      \ to max_freq\n    - estimates noise floor and SNR\n    - prints results to\
      \ terminal\n    - saves one JSON object per line to a .jsonl file\n    - publishes\
      \ the same JSON object to NATS\n\"\"\"\n\nimport os\nimport json\nimport time\n\
      import numpy as np\nfrom gnuradio import gr\n\ntry:\n    from pynats2 import\
      \ NATSClient\nexcept Exception:\n    NATSClient = None\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(\n        self,\n        center_freq=207e6,\n        samp_rate=14e6,\n\
      \        fft_size=2048,\n        min_freq=200e6,\n        max_freq=214e6,\n\
      \        avg_alpha=0.1,\n        log_interval=0.01,\n        snr_threshold_db=10,\n\
      \        log_dir=\"/home/iot4ag/sdr/GNUradio_files/data\",\n        source_name=\"\
      sdr:88a29ed9fb92\",\n        publish_nats=True,\n        nats_server=\"nats://localhost:4222\"\
      ,\n        nats_subject=\"sdr.peaks\",\n    ):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"OATS Peak Detector NATS\",\n        \
      \    in_sig=[(np.float32, int(fft_size))],\n            out_sig=None,\n    \
      \    )\n\n        self.center_freq = float(center_freq)\n        self.samp_rate\
      \ = float(samp_rate)\n        self.fft_size = int(fft_size)\n        self.min_freq\
      \ = float(min_freq)\n        self.max_freq = float(max_freq)\n        self.avg_alpha\
      \ = float(avg_alpha)\n        self.log_interval = float(log_interval)\n    \
      \    self.snr_threshold_db = float(snr_threshold_db)\n        self.log_dir =\
      \ str(log_dir)\n        self.source_name = str(source_name)\n\n        self.publish_nats\
      \ = bool(publish_nats)\n        self.nats_server = os.getenv(\"NATS_URL\", str(nats_server))\n\
      \        self.nats_subject = str(nats_subject)\n        self.nc = None\n   \
      \     self.nats_connected = False\n\n        self.avg_power = None\n       \
      \ self.last_log_time = 0.0\n\n        os.makedirs(self.log_dir, exist_ok=True)\n\
      \n        date_str = time.strftime(\"%Y%m%d\")\n        self.log_path = os.path.join(\n\
      \            self.log_dir,\n            f\"b200mini_peak_log_{date_str}.jsonl\"\
      \n        )\n\n        # This assumes FFT block has Shift: Yes\n        self.freqs\
      \ = np.linspace(\n            self.center_freq - self.samp_rate / 2.0,\n   \
      \         self.center_freq + self.samp_rate / 2.0,\n            self.fft_size,\n\
      \            endpoint=False,\n        )\n\n        self.search_mask = (\n  \
      \          (self.freqs >= self.min_freq)\n            & (self.freqs <= self.max_freq)\n\
      \        )\n\n        if not np.any(self.search_mask):\n            raise ValueError(\"\
      Search range does not overlap FFT frequency range.\")\n\n        print(f\"[OATS]\
      \ JSONL logging to: {self.log_path}\", flush=True)\n        print(\n       \
      \     f\"[OATS] Search range: {self.min_freq/1e6:.3f} MHz to {self.max_freq/1e6:.3f}\
      \ MHz\",\n            flush=True,\n        )\n\n        if self.publish_nats:\n\
      \            self._connect_nats()\n\n    def _connect_nats(self):\n        if\
      \ NATSClient is None:\n            print(\"[OATS] pynats2 is not installed.\
      \ NATS publishing disabled.\", flush=True)\n            self.nats_connected\
      \ = False\n            return\n\n        try:\n            self.nc = NATSClient(self.nats_server,\
      \ socket_timeout=2)\n            self.nc.connect()\n            self.nats_connected\
      \ = True\n            print(\n                f\"[OATS] Connected to NATS: {self.nats_server},\
      \ subject: {self.nats_subject}\",\n                flush=True,\n           \
      \ )\n        except Exception as e:\n            self.nats_connected = False\n\
      \            print(f\"[OATS] Could not connect to NATS: {e}\", flush=True)\n\
      \n    def _publish_nats(self, json_dump):\n        if not self.publish_nats:\n\
      \            return\n\n        if not self.nats_connected:\n            self._connect_nats()\n\
      \n        if not self.nats_connected:\n            return\n\n        try:\n\
      \            self.nc.publish(subject=self.nats_subject, payload=json_dump)\n\
      \        except Exception as e:\n            self.nats_connected = False\n \
      \           print(f\"[OATS] NATS publish failed: {e}\", flush=True)\n\n    def\
      \ work(self, input_items, output_items):\n        spectra = input_items[0]\n\
      \n        for power in spectra:\n            # Prevent log10(0)\n          \
      \  power = np.maximum(power, 1e-20)\n\n            # Exponential moving average\
      \ of power spectrum\n            if self.avg_power is None:\n              \
      \  self.avg_power = power.copy()\n            else:\n                self.avg_power\
      \ = (\n                    self.avg_alpha * power\n                    + (1.0\
      \ - self.avg_alpha) * self.avg_power\n                )\n\n            now =\
      \ time.time()\n\n            # Only print/log/publish every log_interval seconds\n\
      \            if now - self.last_log_time < self.log_interval:\n            \
      \    continue\n\n            self.last_log_time = now\n\n            search_power\
      \ = self.avg_power[self.search_mask]\n            search_freqs = self.freqs[self.search_mask]\n\
      \n            peak_idx = int(np.argmax(search_power))\n            peak_freq_hz\
      \ = float(search_freqs[peak_idx])\n\n            search_power_db = 10.0 * np.log10(np.maximum(search_power,\
      \ 1e-20))\n            peak_power_db = float(search_power_db[peak_idx])\n  \
      \          noise_floor_db = float(np.median(search_power_db))\n            snr_db\
      \ = float(peak_power_db - noise_floor_db)\n\n            detected = bool(snr_db\
      \ >= self.snr_threshold_db)\n\n            record = {\n                \"source\"\
      : self.source_name,\n                \"timestamp_unix\": now,\n            \
      \    \"timestamp_local\": time.strftime(\"%Y-%m-%d %H:%M:%S\"),\n          \
      \      \"center_freq_hz\": self.center_freq,\n                \"sample_rate_hz\"\
      : self.samp_rate,\n                \"fft_size\": self.fft_size,\n          \
      \      \"min_freq_hz\": self.min_freq,\n                \"max_freq_hz\": self.max_freq,\n\
      \                \"avg_alpha\": self.avg_alpha,\n                \"peak_freq_hz\"\
      : peak_freq_hz,\n                \"peak_freq_mhz\": peak_freq_hz / 1e6,\n  \
      \              \"peak_power_db_relative\": peak_power_db,\n                \"\
      noise_floor_db_relative\": noise_floor_db,\n                \"snr_db\": snr_db,\n\
      \                \"snr_threshold_db\": self.snr_threshold_db,\n            \
      \    \"detected\": detected,\n            }\n\n            json_dump = json.dumps(record)\n\
      \n            print(\n                \"Peak: {:.6f} MHz | Power: {:.1f} dB\
      \ rel | Noise: {:.1f} dB rel | SNR: {:.1f} dB | Detected: {}\".format(\n   \
      \                 record[\"peak_freq_mhz\"],\n                    peak_power_db,\n\
      \                    noise_floor_db,\n                    snr_db,\n        \
      \            detected,\n                ),\n                flush=True,\n  \
      \          )\n\n            # Local backup log\n            with open(self.log_path,\
      \ \"a\") as f:\n                f.write(json_dump + \"\\n\")\n\n           \
      \ # NATS publish\n            self._publish_nats(json_dump)\n            \n\
      \        return len(input_items[0])\n        \n    def stop(self):\n       \
      \ print(\"[OATS] Stopping block and closing NATS connection...\", flush=True)\n\
      \n        try:\n            if self.nc is not None:\n                self.nc.close()\n\
      \        except Exception as e:\n            print(f\"[OATS] Error closing NATS:\
      \ {e}\", flush=True)\n\n        self.nats_connected = False\n        return\
      \ True\n"
    affinity: ''
    alias: ''
    avg_alpha: avg_alpha
    center_freq: center_freq
    comment: ''
    fft_size: fft_size
    log_dir: '"/home/iot4ag/sdr/GNUradio_files/data"'
    log_interval: publish_interval
    max_freq: max_freq
    maxoutbuf: '0'
    min_freq: min_freq
    minoutbuf: '0'
    nats_server: '"nats://localhost:4222"'
    nats_subject: '"sdr.peaks"'
    publish_nats: 'True'
    samp_rate: samp_rate
    snr_threshold_db: snr_threshold_db
    source_name: '''sdr:88a29ed9fb92'''
  states:
    _io_cache: ('OATS Peak Detector NATS', 'blk', [('center_freq', '207000000.0'),
      ('samp_rate', '14000000.0'), ('fft_size', '2048'), ('min_freq', '200000000.0'),
      ('max_freq', '214000000.0'), ('avg_alpha', '0.1'), ('log_interval', '0.01'),
      ('snr_threshold_db', '10'), ('log_dir', "'/home/iot4ag/sdr/GNUradio_files/data'"),
      ('source_name', "'sdr:88a29ed9fb92'"), ('publish_nats', 'True'), ('nats_server',
      "'nats://localhost:4222'"), ('nats_subject', "'sdr.peaks'")], [('0', 'float',
      2048)], [], '', ['avg_alpha', 'center_freq', 'fft_size', 'log_dir', 'log_interval',
      'max_freq', 'min_freq', 'nats_server', 'nats_subject', 'publish_nats', 'samp_rate',
      'snr_threshold_db', 'source_name'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 148.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nFull FFT NATS Publisher for OATS/B200mini debug streaming.\n\
      \nInput:\n    float32 vector of FFT power values after:\n    FFT -> Complex\
      \ to Mag^2\n\nOutput:\n    None\n\nThis block:\n    - averages the full FFT\
      \ power spectrum internally\n    - publishes the averaged full FFT vector to\
      \ NATS at a controlled interval\n    - uses base64-encoded float32 data\n\"\"\
      \"\nimport os\nimport json\nimport time\nimport base64\nimport numpy as np\n\
      from gnuradio import gr\n\ntry:\n    from pynats2 import NATSClient\nexcept\
      \ Exception:\n    NATSClient = None\n\n\nclass blk(gr.sync_block):\n    def\
      \ __init__(\n        self,\n        center_freq=207e6,\n        samp_rate=14e6,\n\
      \        fft_size=2048,\n        nats_server=\"nats://localhost:4222\",\n  \
      \      nats_subject=\"sdr.fft\",\n        publish_nats=True,\n        source_name=\"\
      sdr:88a29ed9fb92\",\n        avg_alpha=0.1,\n        publish_interval=0.01,\n\
      \    ):\n        gr.sync_block.__init__(\n            self,\n            name=\"\
      Full FFT NATS Publisher\",\n            in_sig=[(np.float32, int(fft_size))],\n\
      \            out_sig=None,\n        )\n\n        self.center_freq = float(center_freq)\n\
      \        self.samp_rate = float(samp_rate)\n        self.fft_size = int(fft_size)\n\
      \        self.nats_server = os.getenv(\"NATS_URL\", str(nats_server))\n    \
      \    self.nats_subject = str(nats_subject)\n        self.publish_nats = bool(publish_nats)\n\
      \        self.source_name = str(source_name)\n        self.avg_alpha = float(avg_alpha)\n\
      \        self.publish_interval = float(publish_interval)\n\n        self.avg_power\
      \ = None\n        self.last_publish_time = 0.0\n\n        self.nc = None\n \
      \       self.nats_connected = False\n\n        if self.publish_nats:\n     \
      \       self._connect_nats()\n\n    def _connect_nats(self):\n        if NATSClient\
      \ is None:\n            print(\"[FFT] pynats2 not installed. NATS disabled.\"\
      , flush=True)\n            return\n\n        try:\n            self.nc = NATSClient(self.nats_server,\
      \ socket_timeout=2)\n            self.nc.connect()\n            self.nats_connected\
      \ = True\n            print(\n                f\"[FFT] Connected to NATS: {self.nats_server},\
      \ subject: {self.nats_subject}\",\n                flush=True,\n           \
      \ )\n        except Exception as e:\n            self.nats_connected = False\n\
      \            print(f\"[FFT] Could not connect to NATS: {e}\", flush=True)\n\n\
      \    def _publish(self, payload):\n        if not self.publish_nats:\n     \
      \       return\n\n        if not self.nats_connected:\n            self._connect_nats()\n\
      \n        if not self.nats_connected:\n            return\n\n        try:\n\
      \            self.nc.publish(subject=self.nats_subject, payload=payload)\n \
      \       except Exception as e:\n            self.nats_connected = False\n  \
      \          print(f\"[FFT] NATS publish failed: {e}\", flush=True)\n\n    def\
      \ work(self, input_items, output_items):\n        spectra = input_items[0]\n\
      \n        for spectrum in spectra:\n            spectrum = np.maximum(spectrum,\
      \ 1e-20).astype(np.float32)\n\n            # Internal exponential moving average\n\
      \            if self.avg_power is None:\n                self.avg_power = spectrum.copy()\n\
      \            else:\n                self.avg_power = (\n                   \
      \ self.avg_alpha * spectrum\n                    + (1.0 - self.avg_alpha) *\
      \ self.avg_power\n                ).astype(np.float32)\n\n            now =\
      \ time.time()\n\n            # Publish only every publish_interval seconds\n\
      \            if now - self.last_publish_time < self.publish_interval:\n    \
      \            continue\n\n            self.last_publish_time = now\n\n      \
      \      # Base64 encode averaged float32 power vector\n            fft_b64 =\
      \ base64.b64encode(self.avg_power.tobytes()).decode(\"utf-8\")\n\n         \
      \   record = {\n                \"source\": self.source_name,\n            \
      \    \"timestamp_unix\": now,\n                \"timestamp_local\": time.strftime(\"\
      %Y-%m-%d %H:%M:%S\"),\n                \"center_freq_hz\": self.center_freq,\n\
      \                \"sample_rate_hz\": self.samp_rate,\n                \"span_hz\"\
      : self.samp_rate,\n                \"fft_size\": self.fft_size,\n          \
      \      \"avg_alpha\": self.avg_alpha,\n                \"publish_interval\"\
      : self.publish_interval,\n                \"data_type\": \"float32\",\n    \
      \            \"scale\": \"linear_power\",\n                \"encoding\": \"\
      base64\",\n                \"fft_power_linear\": fft_b64,\n            }\n\n\
      \            json_dump = json.dumps(record)\n            self._publish(json_dump)\n\
      \n            print(\n                f\"[FFT] Published averaged FFT vector:\
      \ {self.fft_size} bins to {self.nats_subject}\",\n                flush=True,\n\
      \            )\n\n        return len(input_items[0])\n        \n    def stop(self):\n\
      \        print(\"[FFT] Stopping block and closing NATS connection...\", flush=True)\n\
      \n        try:\n            if self.nc is not None:\n                self.nc.close()\n\
      \        except Exception as e:\n            print(f\"[FFT] Error closing NATS:\
      \ {e}\", flush=True)\n\n        self.nats_connected = False\n        return\
      \ True\n"
    affinity: ''
    alias: ''
    avg_alpha: avg_alpha
    center_freq: center_freq
    comment: ''
    fft_size: fft_size
    maxoutbuf: '0'
    minoutbuf: '0'
    nats_server: '"nats://localhost:4222"'
    nats_subject: '"sdr.fft"'
    publish_interval: publish_interval
    publish_nats: 'True'
    samp_rate: samp_rate
    source_name: '"sdr:88a29ed9fb92"'
  states:
    _io_cache: ('Full FFT NATS Publisher', 'blk', [('center_freq', '207000000.0'),
      ('samp_rate', '14000000.0'), ('fft_size', '2048'), ('nats_server', "'nats://localhost:4222'"),
      ('nats_subject', "'sdr.fft'"), ('publish_nats', 'True'), ('source_name', "'sdr:88a29ed9fb92'"),
      ('avg_alpha', '0.1'), ('publish_interval', '0.01')], [('0', 'float', 2048)],
      [], '', ['avg_alpha', 'center_freq', 'fft_size', 'nats_server', 'nats_subject',
      'publish_interval', 'publish_nats', 'samp_rate', 'source_name'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 444.0]
    rotation: 0
    state: enabled
